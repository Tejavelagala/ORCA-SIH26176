# Optional LLM configuration
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Weather provider
WEATHER_PROVIDER=open-meteo

# Optional approved IMD marine endpoint.
# Leave empty to keep the adapter in safe "unconfigured" mode.
IMD_MARINE_URL=
INCOIS_PFZ_URL=https://www.incois.gov.in/MarineFisheries/TextDataHome?mfid=1&request_locale=en

# Optional authoritative GeoJSON layer file
GEO_LAYERS_PATH=
